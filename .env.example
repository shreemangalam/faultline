# Copy to .env for local Docker Compose use after service configuration exists.
# Values here are deliberately non-sensitive development defaults.
POSTGRES_DB=faultline
POSTGRES_USER=faultline
POSTGRES_PASSWORD=change-me-locally
# Local-only operator credential used by Survey and Restore mutating endpoints.
# Replace this value before exposing either API outside localhost.
FAULTLINE_API_KEY=replace-with-at-least-16-random-characters

# Optional host ports for a second isolated operations stack.
OPERATIONS_DASHBOARD_PORT=3002
OPERATIONS_SURVEY_PORT=18081
OPERATIONS_RESTORE_PORT=18082
# When running Restore outside Compose with a separately hosted downstream:
# RESTORE_DOWNSTREAM_BASE_URL=http://localhost:9090
# RESTORE_DOWNSTREAM_API_KEY=separate-target-credential
