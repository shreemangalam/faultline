            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImpactAnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecoverySequenceResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "operatorApiKey": []
          }
        ],
        "x-faultline-role": "operator"
      }
    },
    "/api/v1/analysis/impact": {
      "post": {
        "tags": [
