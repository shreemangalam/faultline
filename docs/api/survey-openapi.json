{
  "openapi": "3.1.0",
  "info": {
    "title": "Faultline Survey API",
    "description": "Fictional integration-landscape analysis API. Mutating operations require an operator API key.",
    "version": "v1"
  },
  "paths": {
    "/api/v1/landscape/imports/{importId}/activate": {
      "put": {
        "tags": [
          "landscape-import-persistence-controller"
        ],
        "operationId": "activate",
        "parameters": [
          {
            "name": "importId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoredLandscapeResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "operatorApiKey": []
          }
        ],
        "x-faultline-role": "operator"
      }
    },
    "/api/v1/landscape/imports": {
      "post": {
        "tags": [
          "landscape-import-persistence-controller"
        ],
        "operationId": "store",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LandscapeImportValidationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "security": [
          {
            "operatorApiKey": []
          }
        ],
        "x-faultline-role": "operator"
      }
    },
    "/api/v1/landscape/import/validate": {
      "post": {
        "tags": [
          "landscape-import-validation-controller"
        ],
        "operationId": "validate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LandscapeImportValidationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LandscapeImportValidationResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "operatorApiKey": []
          }
        ],
        "x-faultline-role": "operator"
      }
    },
    "/api/v1/analysis/recovery-sequence": {
      "post": {
        "tags": [
          "recovery-sequence-controller"
        ],
        "operationId": "plan",
