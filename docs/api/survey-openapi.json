{
  "openapi": "3.1.0",
  "info": { "title": "Faultline Survey API", "version": "v1", "description": "Fictional integration-landscape analysis API." },
  "paths": {
    "/api/v1/survey/status": { "get": { "operationId": "surveyStatus", "responses": { "200": { "description": "Service status", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Status" } } } } } } },
    "/api/v1/landscape/health-map": { "get": { "operationId": "landscapeHealthMap", "responses": { "200": { "description": "Active topology", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/HealthMap" } } } } } } },
    "/api/v1/landscape/warnings": { "get": { "operationId": "landscapeWarnings", "responses": { "200": { "description": "Topology warnings", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Warnings" } } } } } } },
    "/api/v1/landscape/active": { "get": { "operationId": "activeLandscape", "responses": { "200": { "description": "Active imported landscape", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LandscapeImport" } } } }, "404": { "description": "Bundled sample is active" } } } },
    "/api/v1/landscape/import/validate": { "post": { "operationId": "validateLandscapeImport", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LandscapeDefinition" } } } }, "responses": { "200": { "description": "Validation result", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ImportValidation" } } } }, "400": { "description": "Invalid input", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ImportValidation" } } } } } } },
    "/api/v1/landscape/imports": { "post": { "operationId": "storeLandscapeImport", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LandscapeDefinition" } } } }, "responses": { "201": { "description": "Stored immutable import", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LandscapeImport" } } } }, "400": { "description": "Invalid import" } } } },
    "/api/v1/landscape/imports/{importId}": { "get": { "operationId": "getLandscapeImport", "parameters": [{ "$ref": "#/components/parameters/ImportId" }], "responses": { "200": { "description": "Stored import", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LandscapeImport" } } } }, "404": { "description": "Not found" } } } },
    "/api/v1/landscape/imports/{importId}/activate": { "put": { "operationId": "activateLandscapeImport", "parameters": [{ "$ref": "#/components/parameters/ImportId" }], "responses": { "200": { "description": "Active import", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/LandscapeImport" } } } }, "404": { "description": "Not found" } } } },
    "/api/v1/analysis/impact": { "post": { "operationId": "createImpactReport", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IncidentRequest" } } } }, "responses": { "201": { "description": "Persisted report", "headers": { "Location": { "schema": { "type": "string", "format": "uri" } } }, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ImpactReport" } } } }, "404": { "description": "Unknown system" } } } },
    "/api/v1/analysis/impact/{reportId}": { "get": { "operationId": "getImpactReport", "parameters": [{ "$ref": "#/components/parameters/ReportId" }], "responses": { "200": { "description": "Persisted report", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ImpactReport" } } } }, "404": { "description": "Not found" } } } },
    "/api/v1/analysis/impact-priorities": { "post": { "operationId": "impactPriorities", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IncidentRequest" } } } }, "responses": { "200": { "description": "Ranked priority view", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Priorities" } } } } } } },
    "/api/v1/analysis/recovery-sequence": { "post": { "operationId": "recoverySequence", "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/IncidentRequest" } } } }, "responses": { "200": { "description": "Safe recovery sequence", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Recovery" } } } } } } }
  },
  "components": {
    "parameters": { "ImportId": { "name": "importId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } }, "ReportId": { "name": "reportId", "in": "path", "required": true, "schema": { "type": "string", "format": "uuid" } } },
    "schemas": {
      "Status": { "type": "object", "required": ["service", "status"], "properties": { "service": { "type": "string" }, "status": { "type": "string" } } },
      "IncidentRequest": { "type": "object", "required": ["systemId", "degradationType"], "properties": { "systemId": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$" }, "degradationType": { "type": "string", "enum": ["COMPLETE_OUTAGE"] } } },
      "System": { "type": "object", "required": ["systemId", "label", "criticality"], "properties": { "systemId": { "type": "string" }, "label": { "type": "string" }, "criticality": { "type": "integer", "minimum": 1, "maximum": 10 }, "health": { "type": "string" } } },
      "Integration": { "type": "object", "required": ["integrationId", "sourceSystemId", "targetSystemId", "protocol", "dataDomain", "slaClass"], "properties": { "integrationId": { "type": "string" }, "sourceSystemId": { "type": "string" }, "targetSystemId": { "type": "string" }, "protocol": { "type": "string" }, "dataDomain": { "type": "string" }, "slaClass": { "type": "string", "enum": ["REAL_TIME", "NEAR_REAL_TIME", "BATCH"] } } },
      "LandscapeDefinition": { "type": "object", "required": ["systems", "integrations"], "properties": { "systems": { "type": "array", "items": { "$ref": "#/components/schemas/System" } }, "integrations": { "type": "array", "items": { "$ref": "#/components/schemas/Integration" } } } },
      "LandscapeImport": { "allOf": [{ "$ref": "#/components/schemas/LandscapeDefinition" }, { "type": "object", "required": ["importId", "createdAt"], "properties": { "importId": { "type": "string", "format": "uuid" }, "createdAt": { "type": "string", "format": "date-time" } } }] },
      "HealthMap": { "type": "object", "properties": { "systems": { "type": "array", "items": { "$ref": "#/components/schemas/System" } }, "integrations": { "type": "array", "items": { "$ref": "#/components/schemas/Integration" } } } },
      "Warnings": { "type": "object", "required": ["warnings"], "properties": { "warnings": { "type": "array", "items": { "type": "string" } } } },
      "ImportValidation": { "type": "object", "required": ["valid", "issues"], "properties": { "valid": { "type": "boolean" }, "issues": { "type": "array", "items": { "type": "object" } } } },
      "Priorities": { "type": "object", "properties": { "failedSystemId": { "type": "string" }, "priorities": { "type": "array", "items": { "type": "object" } } } },
      "Recovery": { "type": "object", "required": ["recoverySequence", "cycleWarning", "unresolvedSystemIds"], "properties": { "recoverySequence": { "type": "array", "items": { "type": "string" } }, "cycleWarning": { "type": "boolean" }, "unresolvedSystemIds": { "type": "array", "items": { "type": "string" } } } },
      "ImpactReport": { "type": "object", "required": ["reportId", "createdAt", "landscapeReference", "incident", "affectedSystems", "affectedIntegrations", "priorities", "recovery", "warnings"], "properties": { "reportId": { "type": "string", "format": "uuid" }, "createdAt": { "type": "string", "format": "date-time" }, "landscapeReference": { "type": "string" }, "incident": { "$ref": "#/components/schemas/IncidentRequest" }, "affectedSystems": { "type": "array", "items": { "type": "object" } }, "affectedIntegrations": { "type": "array", "items": { "$ref": "#/components/schemas/Integration" } }, "priorities": { "type": "array", "items": { "type": "object" } }, "recovery": { "$ref": "#/components/schemas/Recovery" }, "warnings": { "type": "array", "items": { "type": "string" } } } }
    }
  }
}