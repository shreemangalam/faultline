        "operationId": "findById",
        "parameters": [
          {
            "name": "importId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoredLandscapeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/landscape/health-map": {
      "get": {
