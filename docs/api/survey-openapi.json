              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StoredImpactReportResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "operatorApiKey": []
          }
        ],
        "x-faultline-role": "operator"
      }
    },
    "/api/v1/analysis/impact-priorities": {
