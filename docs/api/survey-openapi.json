  "components": {
    "schemas": {
      "IntegrationResponse": {
        "type": "object",
        "properties": {
          "integrationId": {
            "type": "string"
          },
          "sourceSystemId": {
            "type": "string"
          },
          "targetSystemId": {
            "type": "string"
          },
          "protocol": {
            "type": "string"
          },
          "dataDomain": {
            "type": "string"
          },
          "slaClass": {
            "type": "string"
          }
        }
      },
      "StoredLandscapeResponse": {
        "type": "object",
        "properties": {
          "importId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "systems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SystemResponse"
            }
          },
          "integrations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IntegrationResponse"
            }
          }
        }
      },
      "SystemResponse": {
        "type": "object",
        "properties": {
          "systemId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "criticality": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "IntegrationRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "sourceSystemId": {
            "type": "string"
          },
          "targetSystemId": {
            "type": "string"
          },
          "protocol": {
            "type": "string"
          },
          "dataDomain": {
            "type": "string"
          },
          "slaClass": {
            "type": "string"
          }
        }
      },
      "LandscapeImportValidationRequest": {
        "type": "object",
        "properties": {
          "systems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SystemRequest"
            }
          },
          "integrations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IntegrationRequest"
            }
          }
        }
      },
      "SystemRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "criticality": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "LandscapeImportValidationResponse": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean"
          },
          "systemCount": {
            "type": "integer",
            "format": "int32"
          },
          "integrationCount": {
            "type": "integer",
            "format": "int32"
          },
          "issues": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ValidationIssueResponse"
            }
          }
        }
      },
      "ValidationIssueResponse": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ImpactAnalysisRequest": {
        "type": "object",
        "properties": {
          "systemId": {
            "type": "string",
            "minLength": 1,
            "pattern": "[A-Z][A-Z0-9_]{1,63}"
          },
          "degradationType": {
            "type": "string",
            "enum": [
              "COMPLETE_OUTAGE"
            ]
          }
        },
        "required": [
          "degradationType",
          "systemId"
        ]
      },
      "RecoverySequenceResponse": {
        "type": "object",
        "properties": {
          "failedSystemId": {
            "type": "string"
          },
          "recoverySequence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cycleWarning": {
            "type": "boolean"
          },
          "unresolvedSystemIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "AffectedIntegration": {
        "type": "object",
        "properties": {
          "integrationId": {
            "type": "string"
          },
          "sourceSystemId": {
            "type": "string"
          },
          "targetSystemId": {
            "type": "string"
          },
          "protocol": {
            "type": "string"
          },
          "dataDomain": {
            "type": "string"
          },
          "slaClass": {
            "type": "string"
          },
          "impactRing": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "AffectedSystem": {
        "type": "object",
        "properties": {
          "systemId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "impactRing": {
            "type": "integer",
            "format": "int32"
          },
          "classification": {
            "type": "string"
          }
        }
      },
      "Incident": {
        "type": "object",
        "properties": {
          "systemId": {
            "type": "string"
          },
          "degradationType": {
            "type": "string"
          }
        }
      },
      "Priority": {
        "type": "object",
        "properties": {
          "systemId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "impactRing": {
            "type": "integer",
            "format": "int32"
          },
          "score": {
            "type": "integer",
            "format": "int32"
          },
          "severity": {
            "type": "string"
          },
          "scoreBreakdown": {
            "$ref": "#/components/schemas/ScoreBreakdown"
          }
        }
      },
      "Recovery": {
        "type": "object",
        "properties": {
          "recoverySequence": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cycleWarning": {
            "type": "boolean"
          },
          "unresolvedSystemIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ScoreBreakdown": {
        "type": "object",
        "properties": {
          "criticalityPoints": {
            "type": "integer",
            "format": "int32"
          },
          "fanOutPoints": {
            "type": "integer",
            "format": "int32"
          },
          "slaPoints": {
            "type": "integer",
            "format": "int32"
          },
          "proximityPoints": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "StoredImpactReportResponse": {
        "type": "object",
        "properties": {
          "reportId": {
            "type": "string",
            "format": "uuid"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "landscapeReference": {
            "type": "string"
          },
          "incident": {
            "$ref": "#/components/schemas/Incident"
          },
          "affectedSystems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AffectedSystem"
            }
          },
          "affectedIntegrations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AffectedIntegration"
            }
          },
          "priorities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Priority"
            }
          },
          "recovery": {
            "$ref": "#/components/schemas/Recovery"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "ImpactPriorityResponse": {
        "type": "object",
        "properties": {
          "failedSystemId": {
            "type": "string"
          },
          "priorities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PrioritizedSystemResponse"
            }
          }
        }
      },
      "PrioritizedSystemResponse": {
        "type": "object",
        "properties": {
          "systemId": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "impactRing": {
            "type": "integer",
            "format": "int32"
          },
          "score": {
            "type": "integer",
            "format": "int32"
          },
          "severity": {
            "type": "string"
          },
          "scoreBreakdown": {
            "$ref": "#/components/schemas/ScoreBreakdownResponse"
          }
        }
      },
      "ScoreBreakdownResponse": {
        "type": "object",
        "properties": {
          "criticalityPoints": {
            "type": "integer",
            "format": "int32"
          },
          "fanOutPoints": {
            "type": "integer",
            "format": "int32"
          },
          "slaPoints": {
            "type": "integer",
            "format": "int32"
          },
          "proximityPoints": {
            "type": "integer",
            "format": "int32"
          }
        }
      },
      "SurveyStatusResponse": {
        "type": "object",
        "properties": {
          "module": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "WarningResponse": {
        "type": "object",
        "properties": {
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "LandscapeHealthMapResponse": {
        "type": "object",
        "properties": {
          "systems": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SystemResponse"
            }
          },
          "integrations": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/IntegrationResponse"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "operatorApiKey": {
        "type": "apiKey",
        "name": "X-Faultline-Api-Key",
        "in": "header"
      }
    }
  }
}
