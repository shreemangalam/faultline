          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ImpactAnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ImpactPriorityResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "operatorApiKey": []
          }
        ],
        "x-faultline-role": "operator"
      }
    },
    "/api/v1/survey/status": {
      "get": {
        "tags": [
          "survey-status-controller"
        ],
        "operationId": "status",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SurveyStatusResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/landscape/warnings": {
      "get": {
        "tags": [
          "landscape-warning-controller"
        ],
        "operationId": "warnings",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WarningResponse"
                }
              }
