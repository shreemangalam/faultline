  "components": {
    "schemas": {
      "ConfigureSimulatorTargetRequest": {
        "type": "object",
        "properties": {
          "behavior": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "TEMPORARY_UNAVAILABLE",
              "RATE_LIMITED",
              "DELAYED_SUCCESS",
              "VALIDATION_FAILURE"
            ]
          },
          "delayMillis": {
            "type": "integer",
            "format": "int64",
            "maximum": 10000,
            "minimum": 0
          },
          "resetHistory": {
            "type": "boolean"
          }
        },
        "required": [
          "behavior"
        ]
      },
      "SimulatorTargetResponse": {
        "type": "object",
        "properties": {
          "targetSystem": {
            "type": "string"
          },
          "behavior": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "TEMPORARY_UNAVAILABLE",
              "RATE_LIMITED",
              "DELAYED_SUCCESS",
              "VALIDATION_FAILURE"
            ]
          },
          "delayMillis": {
            "type": "integer",
            "format": "int64"
          },
          "requestCount": {
            "type": "integer",
            "format": "int64"
          },
          "acceptedCount": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ExecuteRecoveryBatchRequest": {
        "type": "object",
        "properties": {
          "workerId": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "maxEvents": {
            "type": "integer",
            "format": "int32",
            "maximum": 10,
            "minimum": 1
          },
          "leaseSeconds": {
            "type": "integer",
            "format": "int32",
            "maximum": 300,
            "minimum": 30
          }
        },
        "required": [
          "workerId"
        ]
      },
      "ExecutedRecoveryEventResponse": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "ELIGIBLE",
              "BLOCKED",
              "IN_PROGRESS",
              "RETRY_SCHEDULED",
              "COMPLETED",
              "EXHAUSTED",
              "FAILED_FINAL",
              "FAILED_DEPENDENCY"
            ]
          },
          "classification": {
            "type": "string",
            "enum": [
              "SUCCESS",
              "TRANSIENT_FAILURE",
              "PERMANENT_FAILURE"
            ]
          },
          "httpStatus": {
            "type": "integer",
            "format": "int32"
          },
          "durationMillis": {
            "type": "integer",
            "format": "int64"
          },
          "reason": {
            "type": "string"
          },
          "releasedEventIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "ClaimRecoveryEventsRequest": {
        "type": "object",
        "properties": {
          "workerId": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "maxEvents": {
            "type": "integer",
            "format": "int32",
            "maximum": 50,
            "minimum": 1
          },
          "leaseSeconds": {
            "type": "integer",
            "format": "int32",
            "maximum": 300,
            "minimum": 1
          }
        },
        "required": [
          "workerId"
        ]
      },
      "ClaimedRecoveryEventResponse": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "correlationId": {
            "type": "string"
          },
          "targetSystem": {
            "type": "string"
          },
          "payloadReference": {
            "type": "string"
          },
          "priority": {
            "type": "integer",
            "format": "int32"
          },
          "attemptCount": {
            "type": "integer",
            "format": "int32"
          },
          "leaseOwner": {
            "type": "string"
          },
          "leaseExpiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "RetryRecoveryEventRequest": {
        "type": "object",
        "properties": {
          "workerId": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "reason": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          }
        },
        "required": [
          "reason",
          "workerId"
        ]
      },
      "RetryRecoveryEventResponse": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "ELIGIBLE",
              "BLOCKED",
              "IN_PROGRESS",
              "RETRY_SCHEDULED",
              "COMPLETED",
              "EXHAUSTED",
              "FAILED_FINAL",
              "FAILED_DEPENDENCY"
            ]
          },
          "nextEligibleAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FailRecoveryEventRequest": {
        "type": "object",
        "properties": {
          "workerId": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "reason": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          }
        },
        "required": [
          "reason",
          "workerId"
        ]
      },
      "FailedRecoveryEventResponse": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "state": {
            "type": "string",
            "enum": [
              "RECEIVED",
              "ELIGIBLE",
              "BLOCKED",
              "IN_PROGRESS",
              "RETRY_SCHEDULED",
              "COMPLETED",
              "EXHAUSTED",
              "FAILED_FINAL",
              "FAILED_DEPENDENCY"
            ]
          }
        }
      },
      "CompleteRecoveryEventRequest": {
        "type": "object",
        "properties": {
          "workerId": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          }
        },
        "required": [
          "workerId"
        ]
      },
      "CompletedRecoveryEventResponse": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "releasedEventIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "SimulatedDeliveryRequest": {
        "type": "object",
        "properties": {
          "eventId": {
            "type": "string",
            "format": "uuid"
          },
          "correlationId": {
            "type": "string",
            "maxLength": 100,
            "minLength": 0
          },
          "payloadReference": {
            "type": "string",
            "maxLength": 255,
            "minLength": 0
          }
        },
        "required": [
          "correlationId",
          "eventId",
          "payloadReference"
        ]
      },
      "SimulatedDeliveryResponse": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "duplicate": {
            "type": "boolean"
          },
          "receiptId": {
            "type": "string",
            "format": "uuid"
          },
          "outcome": {
            "type": "string"
          }
        }
      },
      "ThunderingHerdScenarioRequest": {
        "type": "object",
        "properties": {
          "eventCount": {
            "type": "integer",
            "format": "int32",
            "maximum": 50000,
            "minimum": 1
          }
        }
      },
      "ThunderingHerdScenarioResponse": {
        "type": "object",
